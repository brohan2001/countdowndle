# Copy to .env.local. For local development use `supabase status` output.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local: the ANON_KEY (JWT) or PUBLISHABLE_KEY from `supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=
